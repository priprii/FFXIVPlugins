<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Plain class library — shared IPC/data-model types between the PyonPix Dalamud
    plugin and the out-of-process PyonPix.Mediator. No Dalamud/FFXIVClientStructs
    dependency, so it does NOT use the Dalamud.NET.Sdk.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>PyonPix.Shared</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <Version>1.0.0.0</Version>
    <PackageProjectUrl>https://github.com/priprii/FFXIVPlugins</PackageProjectUrl>
    <Authors>Pyon</Authors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.FlatBuffers" Version="25.2.10" />
  </ItemGroup>
</Project>
