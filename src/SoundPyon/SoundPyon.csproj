<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <AssemblyName>SoundPyon</AssemblyName>
    <Version>1.0.3.0</Version>
    <Description>Filter out sounds that you don't like!</Description>
    <PackageProjectUrl>https://github.com/priprii/FFXIVPlugins</PackageProjectUrl>
    <Authors>Pyon</Authors>
    <IsPackable>false</IsPackable>
    <RootNamespace></RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="SoundPyon.Resources.nosound.scd" />
    <EmbeddedResource Include="SoundPyon.Resources.nosound.scd" LogicalName="SoundPyon.Resources.nosound.scd" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotNet.Glob" Version="3.1.3" />
  </ItemGroup>
</Project>
